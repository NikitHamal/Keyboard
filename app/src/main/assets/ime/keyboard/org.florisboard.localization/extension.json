{
  "$": "ime.extension.keyboard",
  "meta": {
    "id": "org.florisboard.localization",
    "version": "0.2.0",
    "title": "Default subtype presets / popup mappings",
    "description": "Default subtype presets and popup mappings which are always available.",
    "maintainers": [
      "patrickgold <patrick@patrickgold.dev>"
    ],
    "license": "apache-2.0"
  },
  "dependencies": [
    "org.florisboard.composers",
    "org.florisboard.currencysets",
    "org.florisboard.layouts"
  ],
  "punctuationRules": [
    {
      "id": "default",
      "label": "Default",
      "symbolsPrecedingAutoSpace": ".,?‽!\"&%)]}»",
      "symbolsFollowingAutoSpace": "",
      "symbolsPrecedingPhantomSpace": ".,;:?‽!&%)]}»©®™",
      "symbolsFollowingPhantomSpace": "¿⸘¡([{",
      "symbolsTerminatingSentence": ".?‽!"
    }
  ],
  "popupMappings": [
    {
      "id": "default",
      "authors": [
        "patrickgold"
      ]
    },
    {
      "id": "en",
      "authors": [
        "patrickgold"
      ]
    },
    {
      "id": "hi-IN",
      "authors": [
        "npnpatidar"
      ]
    },
    {
      "id": "ne",
      "authors": [
        "NikitHamal"
      ]
    }
  ],
  "subtypePresets": [
    {
      "languageTag": "en-US",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:dollar",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "en-UK",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:pound",
      "popupMapping": "org.florisboard.localization:en",
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty"
      }
    },
    {
      "languageTag": "hi-IN",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:indian_rupee",
      "popupMapping": "org.florisboard.localization:hi-IN",
      "preferred": {
        "characters": "org.florisboard.layouts:hindi_in",
        "numericRow": "org.florisboard.layouts:devanagari"
      }
    },
    {
      "languageTag": "ne-NP",
      "composer": "org.florisboard.composers:appender",
      "currencySet": "org.florisboard.currencysets:indian_rupee",
      "popupMapping": "org.florisboard.localization:ne",
      "preferred": {
        "characters": "org.florisboard.layouts:nepali_devanagari",
        "numericRow": "org.florisboard.layouts:devanagari"
      }
    },
    {
      "languageTag": "ne-NP",
      "composer": "org.florisboard.composers:nepali-romanized",
      "currencySet": "org.florisboard.currencysets:indian_rupee",
      "popupMapping": "org.florisboard.localization:en",
      "nlpProviders": {
        "suggestion": "com.nikit.nepalikeyboard.nlp.providers.nepali.lexicon"
      },
      "preferred": {
        "characters": "org.florisboard.layouts:qwerty",
        "numericRow": "org.florisboard.layouts:western_arabic"
      }
    }
  ]
}
