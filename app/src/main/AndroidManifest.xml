<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      =======================================================================
      PRIVACY CONTRACT — READ BEFORE EDITING
      =======================================================================
      This application declares ZERO permissions. In particular it does NOT
      declare android.permission.INTERNET, which means the Android platform
      itself makes it impossible for this process to open a socket. There is
      no telemetry, no crash reporting upload, no remote dictionary fetch.

      Do not add INTERNET to this manifest. If a future feature appears to
      need it, it does not belong in this app: the entire lexicon and the
      entire transliteration engine are bundled and run on-device.
      =======================================================================
    -->

    <!-- IMEs must declare this to expose the settings activity to the system
         IME picker ("gear" button in the keyboard switcher). It grants no
         capability beyond letting the system launch our own config UI. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- INTERNET is declared ONLY for the in-app auto-updater. The keyboard
         service itself never opens a socket: all transliteration, lexicon
         lookup, and clipboard capture run entirely on-device. The network
         permission is used exclusively by UpdateManager in the settings
         activity to check GitHub Releases for newer APK versions and to
         download them. See settings -> Privacy for the full contract. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required by PackageInstaller to prompt the user to install the
         downloaded APK on API 26+. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".NepaliKeyboardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.NepaliKeyboard"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35"
        tools:ignore="UnusedAttribute">

        <!-- ============================ IME SERVICE ====================== -->
        <!--
          requiresBindingToSurface="false": we render into the standard input
          view hierarchy; requesting a surface would force the slower
          SurfaceControl path and break our Compose host.

          android:theme is NOT optional here, and its absence was a hard
          crash. Without an explicit theme the IME window inherits the
          application theme, which does not set windowIsFloating. An IME
          window is a Dialog window, so on OEM ROMs that leaves the floating
          flag unset and the framework hosts the input view inside a real
          AlertDialog whose root LinearLayout is android:id/parentPanel.

          That dialog's view tree carries no ViewTreeLifecycleOwner, so
          ComposeView.onAttachedToWindow() -> resolveParentCompositionContext()
          -> getWindowRecomposer() -> createLifecycleAwareWindowRecomposer()
          throws before our InstallKeyboardViewTreeOwners composable can run
          (it only executes *inside* the composition that is failing to
          start). The fix is two-sided and both halves are required:

            1. this attribute, so the window is declared non-floating; and
            2. NepaliImeService composing with a lifecycle-aware Recomposer
               built from the input view itself via
               createLifecycleAwareWindowRecomposer and handed to it via
               setParentCompositionContext — so the window hierarchy, whose
               root on several OEM builds is that bare parentPanel, is never
               consulted at all (observed on Itel A662LM, Android 12).
               View-tree tags are still set on the ComposeView itself for
               LocalLifecycleOwner / rememberSaveable / viewModel().
        -->
        <service
            android:name=".ime.NepaliImeService"
            android:exported="true"
            android:label="@string/ime_service_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:foregroundServiceType="specialUse"
            android:theme="@style/Theme.NepaliKeyboard.Ime"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <!-- Declares the IME to the system. The subtype block below
                 advertises both English and Nepali so that the per-app
                 language switcher can route to us, and so that
                 InputMethodManager can pick a sensible default subtype. -->
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime_subtypes" />
        </service>

        <!-- ========================= SETTINGS ACTIVITY =================== -->
        <!--
          Exported because the system IME switcher launches it directly via
          Settings.ACTION_INPUT_METHOD_SETTINGS -> gear icon, which uses an
          explicit component intent from outside our process.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.NepaliKeyboard.Transparent"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ==================== FIRST-RUN ONBOARDING ==================== -->
        <!--
          Not exported and not in the launcher: SettingsActivity is the single
          entry point, and it forwards here on first launch (see its onCreate).
          Modelling onboarding as a separate activity rather than a state of the
          settings screen means "show it again" is a one-line startActivity from
          anywhere — a help entry point, a post-reset flow — instead of a mode
          the settings screen has to grow.

          configChanges mirrors SettingsActivity: the wizard holds the current
          step in saveable state and re-reads IME status on resume, so it does
          not need a recreation on rotation — and a recreation mid-wizard would
          flash the first step before the saved index is restored.
        -->
        <activity
            android:name=".settings.OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title"
            android:theme="@style/Theme.NepaliKeyboard"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale" />

        <!-- ========================= QUICK TYPING TEST =================== -->
        <!--
          A plain text field that summons the real system keyboard, so users
          (and reviewers) can exercise the installed IME without leaving the
          app. Not exported: it is an internal sandbox and retains nothing.
          adjustResize so the system keyboard shifts the field above it.
        -->
        <activity
            android:name=".settings.TypingSandboxActivity"
            android:exported="false"
            android:label="@string/sandbox_title"
            android:theme="@style/Theme.NepaliKeyboard"
            android:windowSoftInputMode="adjustResize" />

        <!-- ========================= CRASH / DEBUG ======================= -->
        <!--
          Shown when a previous run died with an uncaught exception. Not
          exported: it displays an internal stack trace, which is diagnostic
          detail about this app and nothing else's business.

          `excludeFromRecents` because a crash report is not a place the user
          navigates back to, and `noHistory` so that returning to it after a
          restart does not resurrect a report the user has already dealt with.

          launchMode="singleTop" so that a crash-on-crash cannot stack several
          copies of the screen on top of each other.
        -->
        <activity
            android:name=".debug.CrashActivity"
            android:exported="false"
            android:label="@string/crash_screen_title"
            android:theme="@style/Theme.NepaliKeyboard"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- ===================== CLIPBOARD CAPTURE PROVIDER ============== -->
        <!--
          A no-op ContentProvider with an empty authority. Its only purpose is
          to run before Application.onCreate() so we can register a
          ClipboardManager.OnPrimaryClipChangedListener as early as possible,
          which lets the in-keyboard clipboard strip capture items copied by
          *other* apps during our process lifetime.
        -->
        <provider
            android:name=".clipboard.ClipboardCaptureInitProvider"
            android:authorities="${applicationId}.clipboardinit"
            android:exported="false"
            android:enabled="true"
            android:initOrder="100" />

        <!-- ===================== INSTALL CALLBACK ======================== -->
        <!--
          Transparent activity that receives the PackageInstaller callback
          when the user confirms or cancels the system install prompt for an
          in-app update. No UI of its own — it finishes immediately after
          observing the result.

          Not exported: it is only launched by our own PendingIntent.
          excludeFromRecents + noHistory so it never appears in the task
          switcher or survives a navigation away.
        -->
        <activity
            android:name=".update.InstallActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true" />
    </application>

</manifest>
