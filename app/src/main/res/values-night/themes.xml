<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark equivalents. The Compose palette is authoritative at runtime;
         these keep the pre-first-frame window in sync with the setting. -->
    <style name="Theme.NepaliKeyboard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nk_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
