<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark equivalents. The Compose palette is authoritative at runtime;
         these keep the pre-first-frame window in sync with the setting. -->
    <style name="Theme.NepaliKeyboard" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nk_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
      Night variant of the IME window theme. This MUST exist in every
      configuration qualifier that the manifest's android:theme can resolve
      against, otherwise the resource lookup fails at window creation and the
      IME dies before it ever draws. Keep it in lockstep with values/themes.xml.
    -->
    <style name="Theme.NepaliKeyboard.Ime" parent="Theme.NepaliKeyboard">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSoftInputMode">adjustNothing</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>

    <style name="Theme.NepaliKeyboard.Transparent" parent="Theme.NepaliKeyboard">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
