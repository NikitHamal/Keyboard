<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      Host theme for the single Activity. The keyboard itself is themed entirely
      in Compose (np.com.nepalikeyboard.ui.theme) because an InputMethodService
      window does not inherit an Activity theme.
    -->
    <style name="Theme.NepaliKeyboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/brand_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="Theme.NepaliKeyboard.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/brand_primary</item>
    </style>

</resources>
