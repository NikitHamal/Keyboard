<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Window-level theme. The Compose layer owns the real palette; these values
      exist so that (a) the window background matches before Compose draws its
      first frame, and (b) the IME window has the correct transparent
      decor so the keyboard can float over the host app.
    -->

    <style name="Theme.NepaliKeyboard" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/nk_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.NepaliKeyboard.Dark" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nk_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!--
      Used by SettingsActivity: the activity sets up edge-to-edge Compose and we
      want a neutral window so there is no coloured flash during the
      activity-created -> first-frame gap.
    -->
    <style name="Theme.NepaliKeyboard.Transparent" parent="Theme.NepaliKeyboard">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!--
      The IME window theme. Applied to <service android:theme="..."> in the
      manifest — not optional. See the comment there: an IME window is a Dialog
      window, and if windowIsFloating is left unset the framework can host the
      input view inside a real AlertDialog (root LinearLayout #parentPanel)
      that carries no ViewTreeLifecycleOwner, which makes Compose throw
      IllegalStateException the instant the input view is attached.

      android:windowIsFloating=false is therefore load-bearing, not cosmetic.
      It is what keeps the input view in the IME's own non-floating window.
      Composition itself never consults that window: the service owns its
      Recomposer and hands it to the input view explicitly.
    -->
    <style name="Theme.NepaliKeyboard.Ime" parent="Theme.NepaliKeyboard">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowSoftInputMode">adjustNothing</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
    </style>

</resources>
