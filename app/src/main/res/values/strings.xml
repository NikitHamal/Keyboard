    <string name="onboarding_welcome_title">Type Nepali, the way you speak it</string>
    <string name="onboarding_welcome_body">Romanized Nepali converts namaste into नमस्ते as you type, with an on-device dictionary. No internet permission, no account, no telemetry — everything runs on this phone.</string>

    <string name="onboarding_enable_title">Enable the keyboard</string>
    <string name="onboarding_enable_body">Android requires you to enable every keyboard manually. Open the language &amp; input settings and turn on Nepali Keyboard.</string>
    <string name="onboarding_enable_action">Open keyboard settings</string>

    <string name="onboarding_select_title">Choose your input method</string>
    <string name="onboarding_select_body">Now pick Nepali Keyboard as the active input method. You can switch any time from the keyboard toolbar.</string>
    <string name="onboarding_select_action">Choose keyboard</string>

    <string name="onboarding_done_title">You are ready</string>
    <string name="onboarding_done_body">Open any text field and start typing. Try romanized Nepali with dhanyabad, gyaan or kshya. Hold shift for caps lock, drag on the spacebar to move the cursor, and swipe left on delete to remove whole words.</string>

