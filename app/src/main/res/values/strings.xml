    <!-- Privacy -->
    <string name="privacy_title">Privacy, by construction</string>
    <string name="privacy_no_internet">The app declares no permissions at all — no INTERNET, no network state, no telemetry SDK.</string>
    <string name="privacy_on_device">Transliteration, dictionary lookup, bigram ranking and learning all run in process on Dispatchers.Default.</string>
    <string name="privacy_no_retention">Nothing is uploaded, nothing leaves the device, and the built-in sandbox keeps no history.</string>
    <string name="privacy_secure_fields">Password, PIN and other sensitive fields bypass suggestions, learning and clipboard capture entirely.</string>
    <string name="privacy_reset_title">Reset</string>
    <string name="privacy_reset_body">Restore every setting to its default value and delete learned words, clipboard history and emoji recents.</string>
