    <string name="settings_privacy_title">Privacy</string>
    <string name="settings_privacy_body">This keyboard declares no network permission at all. The Android platform itself prevents the app from opening a socket, so nothing you type can be transmitted — not keystrokes, not clipboard entries, not learned words. Every dictionary and transliteration rule is bundled inside the APK and evaluated on your device.</string>
    <string name="settings_privacy_bullet_offline">Zero internet access — enforced by the manifest, verified by the absence of android.permission.INTERNET</string>
    <string name="settings_privacy_bullet_notelemetry">No analytics, no crash upload, no advertising identifier</string>
    <string name="settings_privacy_bullet_password">Password fields bypass every learned model and disable suggestions</string>
    <string name="settings_privacy_bullet_clipboard">Clipboard history never leaves the device and can be cleared instantly</string>
    <string name="settings_privacy_bullet_backup">Cloud backup and device transfer are disabled for all app data</string>

