    <!-- ==================== Onboarding ==================== -->
    <string name="onboarding_title">Set up Nepali Keyboard</string>
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_back">Back</string>
    <string name="onboarding_done">Start typing</string>

    <string name="onboarding_step1_title">Welcome</string>
    <string name="onboarding_step1_body">Type Nepali in three ways: a native Devanagari layout, a full English QWERTY layout, or by simply writing Romanised Nepali such as “namaste” and letting the keyboard produce नमस्ते as you type.</string>

    <string name="onboarding_step2_title">Enable the keyboard</string>
    <string name="onboarding_step2_body">Android requires you to switch the keyboard on yourself. Open the system input-method settings and turn on “Nepali Keyboard”.</string>
    <string name="onboarding_step2_action">Open keyboard settings</string>

    <string name="onboarding_step3_title">Choose the keyboard</string>
    <string name="onboarding_step3_body">Now pick Nepali Keyboard as your active input method. You can switch back at any time with the globe key.</string>
    <string name="onboarding_step3_action">Choose input method</string>

    <string name="onboarding_step4_title">Try it out</string>
    <string name="onboarding_step4_body">Tap the field below and type “dhanyabad” or “mero desh”. The suggestion strip shows the literal Romanised form first, then the best Devanagari match, then lexicon alternatives.</string>

    <!-- ==================== Sandbox ==================== -->
    <string name="sandbox_hint">Type anything — nothing is stored</string>
    <string name="sandbox_clear">Clear</string>
    <string name="sandbox_note">This field lives only in memory. It is discarded the moment you leave the screen, and it bypasses the keyboard’s learned model entirely.</string>

