<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="np.com.nepalikeyboard.settings.SettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <!-- Primary universal processing path: romanized Nepali -> Devanagari. -->
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=roman,AsciiCapable,EmojiCapable"
        android:imeSubtypeLocale="ne_NP"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_nepali_roman" />

    <!-- Direct Devanagari layout for native-script typists. -->
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=native"
        android:imeSubtypeLocale="ne_NP"
        android:imeSubtypeMode="keyboard"
        android:label="@string/subtype_nepali_native" />

    <!-- ASCII fallback so the keyboard can be used as the only system IME. -->
    <subtype
        android:icon="@mipmap/ic_launcher"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=english"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:label="@string/subtype_english" />

</input-method>
