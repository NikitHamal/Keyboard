<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon background: a Kathmandu-crimson to deep-maroon
     radial wash. Solid tonal fills only, so it renders identically under
     every OEM launcher mask. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="18"
                android:startY="12"
                android:endX="92"
                android:endY="98"
                android:type="linear">
                <item android:offset="0" android:color="#FFC2404F" />
                <item android:offset="0.55" android:color="#FF8F1D2C" />
                <item android:offset="1" android:color="#FF4E0A14" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
