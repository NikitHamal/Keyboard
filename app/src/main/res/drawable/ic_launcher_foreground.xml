<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground: a stylised Devanagari "क" rendered as a
  vector path so the icon stays crisp at every density with zero binary assets.
  The 108x108 viewport is the adaptive-icon standard; the glyph occupies the
  inner 72x72 safe zone (18dp inset on each side).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Vertical stem of क -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,30 h7 v34 h-7 z" />

    <!-- Top horizontal bar (shirorekha) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,30 h34 v7 h-34 z" />

    <!-- Right arm and bowl of क -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M53,46 h14 a6,6 0 0 1 6,6 v12 a6,6 0 0 1 -6,6 h-6 a6,6 0 0 1 -6,-6 h7 a2,2 0 0 0 2,-2 v-8 a2,2 0 0 0 -2,-2 h-9 z" />

    <!-- Lower-left diagonal foot of क -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,64 l-14,14 h10 l12,-12 v-2 z" />

</vector>
